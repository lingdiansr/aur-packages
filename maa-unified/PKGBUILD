# Maintainer: Your Name <your.email@example.com>

# MAAUnified = MAA 官方跨平台 (Avalonia/.NET) GUI,直接驱动 MaaCore 与 MAA 私有资源。
# 主仓 CI 构建后仅上传 Actions artifact(30 天过期、需登录),匿名无法获取;
# fork(lingdiansr/MaaAssistantArknights)的 workflow 每日同步上游 dev-v2 并构建,
# 产物发布到 Release(固定 tag maaunified-linux-x64),可匿名下载。
# 更新流程:workflow 自动重建;asset 更新后同步修改 _assetver/_commit 与 sha256sums。
pkgname=maa-unified
_assetver=6.16.4
_commit=4044b8ec5
pkgver=${_assetver}.r0.g${_commit}
pkgrel=2
pkgdesc="MAAUnified - official cross-platform (Avalonia) GUI for MAA Arknights assistant"
arch=('x86_64')
url="https://github.com/MaaAssistantArknights/MaaUnified"
# MAAUnified 随主仓发布,均为 AGPL-3.0
license=('AGPL-3.0-only')
depends=(
  'libx11'
  'libxkbcommon'
  'libice'
  'libsm'
  'fontconfig'
  'adb'
)
source=(
  # fork Release 产物(官方 CI 合并后的完整运行目录:应用 + MaaCore runtime + resource)
  "MAAUnified-v${_assetver}-${_commit}-linux-x64.tar.gz::https://github.com/lingdiansr/MaaAssistantArknights/releases/download/maaunified-linux-x64/MAAUnified-v${_assetver}-${_commit}-linux-x64.tar.gz"
  "maa-logo.png::https://raw.githubusercontent.com/MaaAssistantArknights/design/main/v2/icons/maa-logo_512x512.png"
)
sha256sums=(
  '88aee60f8b76dce4255cf45f738a8052831d6b9dc9b3db9ae9b57b019d6b438f'
  '0152e8e867c84cfa9e494db33257c22c2bd7735d2e59113e1f87fd0350d48368'
)

prepare() {
  # tar.gz 顶层即运行目录文件(官方 CI:tar -C publish .)
  mkdir -p maaunified
  tar -xzf "MAAUnified-v${_assetver}-${_commit}-linux-x64.tar.gz" -C maaunified
}

package() {
  _appdir="$pkgdir/opt/$pkgname"
  _bindir="$pkgdir/usr/bin"
  _sharedir="$pkgdir/usr/share"

  # ---- 1. MAAUnified 应用 + MaaCore runtime + 明日方舟资源 ----
  # libMaaCore.so 与 libMaaAdbControlUnit.so 已同级,resource/ 供 MaaCore 加载
  install -dm755 "$_appdir"
  cp -a "$srcdir/maaunified/." "$_appdir/"

  # ---- 2. 可写数据目录 ----
  # MAAUnified 为便携式设计,config/ debug/ data/ 及 drops/ 等全部写程序目录,
  # 且运行时动态创建(data/ 等)。安装于 /opt 后普通用户无写权限会导致
  # UnauthorizedAccessException(日志/首屏初始化失败),故对整个应用目录开放写权限。
  # 注意:多用户共用数据目录;家用单用户场景无冲突。
  chmod -R a+rwX "$_appdir"

  # ---- 3. 启动器 ----
  install -Dm755 /dev/stdin "$_bindir/maa-unified" <<'EOF'
#!/bin/bash
exec /opt/maa-unified/MAAUnified "$@"
EOF

  # ---- 4. .desktop 入口 ----
  install -Dm644 /dev/stdin "$_sharedir/applications/maa-unified.desktop" <<EOF
[Desktop Entry]
Name=MAA Unified
Comment=Official cross-platform GUI for MAA Arknights assistant
Exec=/usr/bin/maa-unified
Icon=maa-unified
Type=Application
Categories=Game;
Terminal=false
EOF

  # ---- 5. 图标 ----
  install -Dm644 "$srcdir/maa-logo.png" "$_sharedir/pixmaps/maa-unified.png"
}
